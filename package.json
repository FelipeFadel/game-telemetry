{
  "name": "linusbae-telemetria",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute linusbae --local --file=schema.sql",
    "db:remoto": "wrangler d1 execute linusbae --remote --file=schema.sql",
    "db:migrar:local": "wrangler d1 execute linusbae --local --file=migracoes/0003_usuarios.sql",
    "db:migrar:remoto": "wrangler d1 execute linusbae --remote --file=migracoes/0003_usuarios.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
